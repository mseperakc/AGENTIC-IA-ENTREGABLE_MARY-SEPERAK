        /// <summary>
        /// Valida una fecha escrita como dd/MM/yyyy. Si no es válida devuelve false y el mensaje para el operador.
        /// </summary>
        private bool ValidarFecha(string texto, string campo, bool permitirFutura, out DateTime fecha, out string mensaje)
        {
            mensaje = String.Empty;
            if (!DateTime.TryParseExact((texto ?? String.Empty).Trim(), "dd/MM/yyyy", new System.Globalization.CultureInfo("es-PE"),
                System.Globalization.DateTimeStyles.None, out fecha))
            {
                mensaje = campo + ": use el formato dd/mm/aaaa (ej. 05/10/2026)";
                return false;
            }
            if (!permitirFutura && fecha.Date > DateTime.Today)
            {
                mensaje = campo + ": no puede ser una fecha futura";
                return false;
            }
            return true;
        }

        public void SetMesActual()
        {
            IFormatProvider cultura = new System.Globalization.CultureInfo("es-PE");
            string FechaNew = string.Empty; string mes = (DateTime.Now.Month).ToString("0#");
            DateTime dFecha;
            if (Convert.ToInt32(mes) < 12)
            {
                FechaNew = "01/" + (DateTime.Now.Month + 1).ToString("0#") + "/" + Convert.ToString(DateTime.Now.Year);
                dFecha = Convert.ToDateTime(FechaNew, cultura);
            }
            else
            {
                FechaNew = "01/" + "01/" + Convert.ToString(DateTime.Now.Year + 1);
                dFecha = Convert.ToDateTime(FechaNew, cultura);
            }

            DateTime dFechaInicio = dFecha.AddMonths(-1);
            DateTime dFechaFin = dFecha.AddDays(-1);

            txtFechaInicio.Text = dFechaInicio.ToString("dd/MM/yyyy");
            txtFechaFin.Text = dFechaFin.ToString("dd/MM/yyyy");

            //txtFechaRD.Text = dFechaInicio.ToString("dd/MM/yyyy");
        }

        private void SetControls()
        {
            try
            {
                //wucFecha1.SetMesActual();
                SetMesActual();
                //
                string strCompania = AppStatic.CompaniaComprobantes();
                ddlbCompania.SelectedValue = strCompania;

                string _query = "select t$ptov$c as codigo, t$ptov$c || ' - ' || t$dsca$c as descripcion from ttcmcs903" + strCompania + " where t$esta = '1' order by t$ptov$c";
                DataTable dtPuntoVenta = FabricaSingleton<DComprobante>.Crear().ObtenerTabla(_query);
                ddlbPuntoVenta1.DataSource = dtPuntoVenta;
                ddlbPuntoVenta1.DataValueField = "codigo";
                ddlbPuntoVenta1.DataTextField = "descripcion";
                ddlbPuntoVenta1.DataBind();

                ddlbPuntoVenta2.DataSource = dtPuntoVenta;
                ddlbPuntoVenta2.DataValueField = "codigo";
                ddlbPuntoVenta2.DataTextField = "descripcion";
                ddlbPuntoVenta2.DataBind();
            }
            catch (Exception ex)
            {
                lblCant.Text = ex.Message;
            }
            
        }

        protected void GoPage(object sender, System.EventArgs e)
        {
            DropDownList oIraPag = (DropDownList)sender;
            Int32 iNumPag = 0;

            if (Int32.TryParse(oIraPag.Text.Trim(), out iNumPag) && iNumPag > 0 && iNumPag <= GridViewDatos.PageCount)
            {
                if ((Int32.TryParse(oIraPag.Text.Trim(), out iNumPag) && iNumPag > 0) && iNumPag <= GridViewDatos.PageCount)
                    GridViewDatos.PageIndex = iNumPag - 1;
                else
                    GridViewDatos.PageIndex = 0;
            }

            ListaComprobantes = (List<EComprobante>)ViewState["Lista"];

            CargarData(ListaComprobantes);
        }

        protected void GridViewDatos_PageIndexChanging(object sender, GridViewPageEventArgs e)
        {
            GridViewDatos.PageIndex = e.NewPageIndex;

            ListaComprobantes = (List<EComprobante>)ViewState["Lista"];
            CheckBox chk = (CheckBox)GridViewDatos.HeaderRow.FindControl("chkheader");
            Boolean val = chk.Checked;

            CargarData(ListaComprobantes);

            if (val)
            {
                CheckBox chk1 = (CheckBox)GridViewDatos.HeaderRow.FindControl("chkheader");
                chk1.Checked = true;
            }
        }

        protected void chkboxSelectAll_CheckedChanged(object sender, EventArgs e)
        {
            CheckBox ChkBoxHeader = (CheckBox)GridViewDatos.HeaderRow.FindControl("chkheader");
            foreach (GridViewRow row in GridViewDatos.Rows)
            {
                CheckBox ChkBoxRows = (CheckBox)row.FindControl("chkAccept");
                if (ChkBoxHeader.Checked == true)
                {
                    ChkBoxRows.Checked = true;
                    SetCheckLists(true);
                }
                else
                {
                    ChkBoxRows.Checked = false;
                    SetCheckLists(false);
                }
            }
        }

        private void SetCheckLists(bool check)
        {
            ListaComprobantes = (List<EComprobante>)ViewState["Lista"];

            foreach (EComprobante item in ListaComprobantes)
            {
                item.Sel = check;
            }

            ViewState["Lista"] = ListaComprobantes;
        }

        protected void GridViewDatos_RowDataBound(object sender, GridViewRowEventArgs e)
        {
            if (e.Row.RowType == DataControlRowType.Pager && !(GridViewDatos.DataSource == null))
            {
                Label _TotalPags = (Label)e.Row.FindControl("lblTotalNumberOfPages");
                _TotalPags.Text = GridViewDatos.PageCount.ToString();

                DropDownList list = (DropDownList)e.Row.FindControl("paginasDropDownList");

                for (int i = 1; i <= GridViewDatos.PageCount; i++)
                {
                    list.Items.Add(i.ToString());
                }
                list.SelectedValue = (GridViewDatos.PageIndex + 1).ToString();
            }
        }

        protected void btnConsultar_Click(object sender, EventArgs e)
        {
            lblCant.Text = "";
            lblCantRegAcep.Visible = false;
            lblCantRegRec.Visible = false;

            lstComprobantes.Visible = true;
            lstResumenDiario.Visible = false;

            try
            {
                BComprobante comprobante = new BComprobante();

                //if (!wucFecha1.DateFechaInicio.HasValue && !wucFecha1.DateFechaFin.HasValue) return;

                if (rblResumenes.SelectedValue.Length > 0)
                {
                    lblCant.Text = "Debe especificar los tipos de comprobantes a consultar";
                    return;
                }

                //DateTime fechainicio = wucFecha1.DateFechaInicio.Value;
                //DateTime fechafin = wucFecha1.DateFechaFin.Value;

                DateTime fechainicio, fechafin;
                string mensajeFecha;
                if (!ValidarFecha(txtFechaInicio.Text, "Fecha desde", true, out fechainicio, out mensajeFecha) ||
                    !ValidarFecha(txtFechaFin.Text, "Fecha hasta", true, out fechafin, out mensajeFecha))
                {
                    lblCant.Text = mensajeFecha;
                    return;
                }
                if (fechafin < fechainicio)
                {
                    lblCant.Text = "La fecha hasta debe ser igual o posterior a la fecha desde";
                    return;
                }

                String tipocomp = rblTipoComprobante.SelectedValue;
                String strEstado = rbEstado.SelectedValue;
                String strPuntoVenta1 = ddlbPuntoVenta1.SelectedValue.ToString();
                String strPuntoVenta2 = ddlbPuntoVenta2.SelectedValue.ToString();

                ListaComprobantes = comprobante.ObtenerComprobantes(fechainicio, fechafin, tipocomp, strPuntoVenta1, strPuntoVenta2, strEstado);

                lblCant.Text = "Se encontraron " + ListaComprobantes.Count.ToString() + " registros";

                ViewState["Lista"] = ListaComprobantes;

                CargarData(ListaComprobantes);
            }
            catch (Exception ex)
            {
                lblCant.Text = ex.Message;
            }
        }

        private void CargarData(List<EComprobante> listacomprobantes)
        {
            GridViewDatos.DataSource = listacomprobantes;
            GridViewDatos.DataBind();
        }

        protected void btnProcesar_Click(object sender, EventArgs e)
        {
            btnProcesar.Enabled = false;
            lblCant.Text = "";
            lblCantRegAcep.Visible = false;
            lblCantRegRec.Visible = false;

            lstComprobantes.Visible = true;
            lstResumenDiario.Visible = false;

            try
            {
                BComprobante comprobante = new BComprobante();

                if (ViewState["Lista"] == null)
                {
                    lblCant.Text = "No existe información a procesar";
                    return;
                }

                ListaComprobantes = (List<EComprobante>)ViewState["Lista"];

                if (ListaComprobantes.Count() == 0)
                {
                    lblCant.Text = "No existe información a procesar";
                    return;
                }

                int cant = 0;

                foreach (GridViewRow dtgItem in GridViewDatos.Rows)
                {
                    CheckBox Sel = ((CheckBox)GridViewDatos.Rows[dtgItem.RowIndex].FindControl("chkAccept"));

                    if (Sel.Checked)
                    {
                        int id = Convert.ToInt32(GridViewDatos.DataKeys[dtgItem.RowIndex].Values[0]);

                        EComprobante comp = ListaComprobantes.Find(x => x.Id == id);
                        comp.Sel = true;
                    }
                }

                cant = ListaComprobantes.FindAll(x => x.Sel == true).Count();

                if (cant == 0)
                {
                    lblCant.Text = "Debe seleccionar al menos un comprobante";
                    return;
                }

                ListaComprobantes = comprobante.ProcesarComprobantes(ListaComprobantes);

                lblCantRegAcep.Visible = true;
                lblCantRegRec.Visible = true;

                lblCantRegAcep.Text = ListaComprobantes.FindAll(x => x.CDR == "0" && x.Sel == true).Count().ToString() + " Registros Aceptados";
                lblCantRegRec.Text = ListaComprobantes.FindAll(x => x.CDR != "0" && x.Sel == true).Count().ToString() + " Registros Rechazados";

                CargarData(ListaComprobantes);
            }
            catch (Exception ex)
            {
                lblCant.Text = ex.Message;
                lblCantRegAcep.Visible = false;
                lblCantRegAcep.Visible = false;
            }
            finally
            {
                btnProcesar.Enabled = true;
            }
        }

