        protected void btnConsultarRD_Click(object sender, EventArgs e)
        {
            lstComprobantes.Visible = false;
            lstResumenDiario.Visible = true;
            gvResumenDiario.Visible = false;




            lblResultadoResumenDiario.Visible = true;

            try
            {
                BComprobante comprobante = new BComprobante();

                //if (!wucFechaRD.DateFechaInicio.HasValue) return;
                //DateTime fecha = wucFechaRD.DateFechaInicio.Value;
                if (txtFechaRD.Text == String.Empty) 
                {
                    lblResultadoResumenDiario.Text = "Ingrese fecha de resumen diario";
                    return;    
                }

                DateTime fecha;
                string mensajeFecha;
                if (!ValidarFecha(txtFechaRD.Text, "Fecha de resumen diario", false, out fecha, out mensajeFecha))
                {
                    lblResultadoResumenDiario.Text = mensajeFecha;
                    return;
                }

                DateTime fechainicio = new DateTime(fecha.Year, fecha.Month, fecha.Day, 0, 0, 0);
                DateTime fechafin = new DateTime(fecha.Year, fecha.Month, fecha.Day, 23, 59, 59);

                String tipocomp = rblTipoComprobante.SelectedValue;

                /////ListaResumenDiario = comprobante.ObtenerResumenDiario(fechainicio, fechafin, tipocomp);
                ListaResumenDiario = comprobante.ObtenerResumenDiario2018(fechainicio, fechafin, tipocomp);

                lblResultadoResumenDiario.Text = "Se encontraron " + ListaResumenDiario.Count.ToString() + " resumenes";

                gvResumenDiario.Visible = ListaResumenDiario.Count > 0;

                ViewState["ListaResumenDiario"] = ListaResumenDiario;

                CargarDataResumen(ListaResumenDiario);
            }
            catch (Exception ex)
            {
                lblResultadoResumenDiario.Text = ex.Message;
                gvResumenDiario.Visible = false;
            }
        }

