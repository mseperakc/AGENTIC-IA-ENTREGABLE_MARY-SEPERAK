        protected void btnActualizar_Click(object sender, EventArgs e)
        {
            lblCant.Text = "";
            lblCantRegAcep.Visible = false;
            lblCantRegRec.Visible = false;

            try
            {
                BComprobante comprobante = new BComprobante();

                if (ViewState["Lista"] == null)
                {
                    lblCant.Text = "No existe información a procesar";
                    return;
                }

                ListaComprobantes = (List<EComprobante>)ViewState["Lista"];

                if (ListaComprobantes.Count() == 0)
                {
                    lblCant.Text = "No existe información a procesar";
                    return;
                }

                int cant = 0;

                foreach (GridViewRow dtgItem in GridViewDatos.Rows)
                {
                    CheckBox Sel = ((CheckBox)GridViewDatos.Rows[dtgItem.RowIndex].FindControl("chkAccept"));

                    if (Sel.Checked)
                    {
                        int id = Convert.ToInt32(GridViewDatos.DataKeys[dtgItem.RowIndex].Values[0]);

                        EComprobante comp = ListaComprobantes.Find(x => x.Id == id);
                        comp.Sel = true;
                    }
                }

                cant = ListaComprobantes.FindAll(x => x.Sel == true).Count();

                if (cant == 0)
                {
                    lblCant.Text = "Debe seleccionar al menos un comprobante";
                    return;
                }

                comprobante.ActualizarComprobantesEnOracle(ListaComprobantes);
            }
            catch (Exception ex)
            {
                lblCant.Text = ex.Message;
                lblCantRegAcep.Visible = false;
                lblCantRegAcep.Visible = false;
            }
        }

        protected void btnGetCDR_Click(object sender, EventArgs e)
        {
            String strRUC = "20100072751";

            btnProcesar.Enabled = false;
            //lblCant.Text = "";
            lblCantRegAcep.Visible = false;
            lblCantRegRec.Visible = false;

            lstComprobantes.Visible = true;
            //lstResumenDiario.Visible = false;

            try
            {
                BComprobante comprobante = new BComprobante();

                if (ViewState["Lista"] == null)
                {
                    //lblCant.Text = "No existe información a procesar";
                    return;
                }

                ListaComprobantes = (List<EComprobante>)ViewState["Lista"];

                if (ListaComprobantes.Count() == 0)
                {
                    //lblCant.Text = "No existe información a procesar";
                    return;
                }

                foreach (GridViewRow dtgItem in GridViewDatos.Rows)
                {
                    CheckBox Sel = ((CheckBox)GridViewDatos.Rows[dtgItem.RowIndex].FindControl("chkAccept"));

                    if (Sel.Checked)
                    {
                        int id = Convert.ToInt32(GridViewDatos.DataKeys[dtgItem.RowIndex].Values[0]);

                        EComprobante comp = ListaComprobantes.Find(x => x.Id == id);

                        String serie = comp.Serie;
                        string strFecha = comp.Fecha.ToString("yyyyMMdd");
                        int correlativo = (int)comp.Correlativo;
                        String strTipo = comp.DocumentoPago;

                        comp.Sel = true;

                        EResultadoProceso resultado = comprobante.ValidarCDR(strRUC, strTipo, serie, correlativo, strFecha);

                        comp.CDR = resultado.CDR;
                        if (comp.CDR == "0")
                            comp.Versionestruct = "ACEPTADO";
                        else
                            comp.Versionestruct = "RECHAZADO";

                        resultado.MsgCDR = resultado.MsgCDR.Replace("'", "");
                        comp.MsgCDR = resultado.MsgCDR;

                        //Actualizar Registro
                        comprobante.ActualizarProcesoCDR(comp);
                    }
                }

                CargarData(ListaComprobantes);

            }
            catch (Exception ex)
            {
                //lblCant.Text = ex.Message;
                lblCantRegAcep.Visible = false;
                lblCantRegAcep.Visible = false;
            }
            finally
            {
                btnProcesar.Enabled = true;
            }
        }

        protected void btnGenerarPDF_Click(object sender, EventArgs e)
        {
            btnGenerarPDF.Enabled = false;
            lblCant.Text = "";
            lblCantRegAcep.Visible = false;
            lblCantRegRec.Visible = false;

            lstComprobantes.Visible = true;
            lstResumenDiario.Visible = false;

            try
            {
                BComprobante comprobante = new BComprobante();

                if (ViewState["Lista"] == null)
                {
                    lblCant.Text = "No existe información a procesar";
                    return;
                }

                ListaComprobantes = (List<EComprobante>)ViewState["Lista"];

                if (ListaComprobantes.Count() == 0)
                {
                    lblCant.Text = "No existe información a procesar";
                    return;
                }

                int cant = 0;

                foreach (GridViewRow dtgItem in GridViewDatos.Rows)
                {
                    CheckBox Sel = ((CheckBox)GridViewDatos.Rows[dtgItem.RowIndex].FindControl("chkAccept"));

                    if (Sel.Checked)
                    {
                        int id = Convert.ToInt32(GridViewDatos.DataKeys[dtgItem.RowIndex].Values[0]);

                        EComprobante comp = ListaComprobantes.Find(x => x.Id == id);
                        comp.Sel = true;
                    }
                }

                cant = ListaComprobantes.FindAll(x => x.Sel == true).Count();

                if (cant == 0)
                {
                    lblCant.Text = "Debe seleccionar al menos un comprobante";
                    return;
                }

                ListaComprobantes = comprobante.ProcesarComprobantesPDF(ListaComprobantes);

                lblCantRegAcep.Visible = true;
                lblCantRegRec.Visible = true;

                lblCantRegAcep.Text = ListaComprobantes.FindAll(x => x.CDR == "0" && x.Sel == true).Count().ToString() + " Registros Aceptados";
                lblCantRegRec.Text = ListaComprobantes.FindAll(x => x.CDR != "0" && x.Sel == true).Count().ToString() + " Registros Rechazados";

                CargarData(ListaComprobantes);
            }
            catch (Exception ex)
            {
                lblCant.Text = ex.Message;
                lblCantRegAcep.Visible = false;
                lblCantRegAcep.Visible = false;
            }
            finally
            {
                btnGenerarPDF.Enabled = true;
            }
        }
    }
}