                            <div class="parrafo"></div>
                            <table id="lstComprobantes" runat="server" width="100%" border="0" cellpadding="0" cellspacing="0" visible="true">
                                <tr>
                                    <td colspan="4">
                                        <asp:GridView ID="GridViewDatos" runat="server" CssClass="grid" Caption="Lista de Comprobantes"
                                            AutoGenerateColumns="false" PageSize="50" AllowPaging="true" DataKeyNames="Id,Fecha"
                                            OnPageIndexChanging="GridViewDatos_PageIndexChanging"
                                            OnRowDataBound="GridViewDatos_RowDataBound">
                                            <Columns>
                                                <asp:TemplateField HeaderText="">
                                                    <HeaderTemplate>
                                                        <asp:CheckBox ID="chkheader" runat="server" AutoPostBack="true" OnCheckedChanged="chkboxSelectAll_CheckedChanged" /></HeaderTemplate>
                                                    <ItemTemplate>
                                                        <asp:CheckBox ID="chkAccept" runat="server" EnableViewState="true" Checked='<%#Convert.ToBoolean(Eval("Sel")) %>' /></ItemTemplate>
                                                </asp:TemplateField>
                                                <asp:BoundField HeaderText="Tipo" DataField="TipoFactura" ItemStyle-Width="150px" />
                                                <asp:BoundField HeaderText="Fecha" DataField="Fecha" DataFormatString="{0:yyyy-MM-dd}" ItemStyle-HorizontalAlign="Left" ItemStyle-Width="160px" />
                                                <asp:BoundField HeaderText="Serie" DataField="Serie" ItemStyle-HorizontalAlign="Left" ItemStyle-Width="60px" />
                                                <asp:BoundField HeaderText="Correlativo" DataField="Correlativo" ItemStyle-HorizontalAlign="Left" ItemStyle-Width="60px" />
                                                <asp:BoundField HeaderText="RUC" DataField="RUC" ItemStyle-HorizontalAlign="Left" ItemStyle-Width="90px" />
                                                <%--<asp:BoundField HeaderText="Tipo Documento" DataField="TipoDocumento" ItemStyle-HorizontalAlign="Left" ItemStyle-Width="200px" />--%>
                                                <asp:BoundField HeaderText="Razon Social" DataField="RazonSocial" ItemStyle-HorizontalAlign="Left" ItemStyle-Width="200px" />
                                                <asp:BoundField HeaderText="Importe" DataField="TotPrecioVta" ItemStyle-HorizontalAlign="Left" ItemStyle-Width="200px" />
                                                <asp:BoundField HeaderText="Estado Comprobante" DataField="Versionestruct" ItemStyle-HorizontalAlign="Left" ItemStyle-Width="300px" />
                                                <asp:BoundField HeaderText="CDR" DataField="CDR" ItemStyle-HorizontalAlign="Left" ItemStyle-Width="140px" />
                                                <asp:BoundField HeaderText="Mensaje SUNAT" DataField="MsgCDR" ItemStyle-HorizontalAlign="Left" ItemStyle-Width="550px" />

                                            </Columns>
                                            <PagerTemplate>
                                                Página 
                                            <asp:DropDownList ID="paginasDropDownList" Font-Size="12px" AutoPostBack="true" OnSelectedIndexChanged="GoPage" runat="server"></asp:DropDownList>
                                                de
                                            <asp:Label ID="lblTotalNumberOfPages" runat="server" />
                                                &nbsp;&nbsp;
                                            <asp:Button ID="Button4" runat="server" CommandName="Page" ToolTip="Prim. Pag" CommandArgument="First" CssClass="pagfirst" />
                                                <asp:Button ID="Button1" runat="server" CommandName="Page" ToolTip="Pág. anterior" CommandArgument="Prev" CssClass="pagprev" />
                                                <asp:Button ID="Button2" runat="server" CommandName="Page" ToolTip="Sig. página" CommandArgument="Next" CssClass="pagnext" />
                                                <asp:Button ID="Button3" runat="server" CommandName="Page" ToolTip="Últ. Pag" CommandArgument="Last" CssClass="paglast" />
                                            </PagerTemplate>
                                            <PagerStyle CssClass="pagerstyle" />
                                        </asp:GridView>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <asp:Label ID="lblCantRegAcep" runat="server" Visible="false" ForeColor="Red" Width="450px"></asp:Label>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <asp:Label ID="lblCantRegRec" runat="server" Visible="false" ForeColor="Red" Width="450px"></asp:Label>
                                    </td>
                                </tr>
                            </table>
