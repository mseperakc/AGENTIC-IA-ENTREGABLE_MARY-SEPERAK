                    <div class="logo"><a href="#" class="logo_editora">Logo Editora</a></div>
                </div>
                <div class="salto"></div>
                <div class="acc_rapidos">
                    <a class="acc_noticias" href="#">Versión del 12/09/2021</a>
                </div>
                <div class="salto"></div>
                <div class="margenes">
