                            <table id="lstComunicacionBaja" runat="server" width="100%" border="0" cellpadding="0" cellspacing="0" visible="false">
                                <tr>
                                    <td colspan="4">
                                        <asp:GridView ID="gvComunicacion" runat="server" CssClass="grid" Caption="Comunicación Baja"
                                            AutoGenerateColumns="False" PageSize="50" AllowPaging="True" Visible="False"
                                            OnPageIndexChanging="gvComunicacion_PageIndexChanging"
                                            OnRowDataBound="gvComunicacion_RowDataBound">
                                            <Columns>
