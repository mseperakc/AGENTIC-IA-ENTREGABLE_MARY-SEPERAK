                                                    DataFormatString="{0:yyyy-MM-dd}" ItemStyle-HorizontalAlign="Left"
                                                    ItemStyle-Width="350px">
                                                    <ItemStyle HorizontalAlign="Left" Width="350px"></ItemStyle>
                                                </asp:BoundField>
                                                <asp:BoundField HeaderText="Tipo Comprobante" DataField="TipoComprobante"
                                                    ItemStyle-HorizontalAlign="Left" ItemStyle-Width="450px">
