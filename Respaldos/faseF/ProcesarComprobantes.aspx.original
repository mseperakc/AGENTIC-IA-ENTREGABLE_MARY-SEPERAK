                                                    <ItemStyle HorizontalAlign="Left" Width="400px"></ItemStyle>
                                                </asp:BoundField>
                                                <asp:BoundField HeaderText="Ventas Inafectas" DataField="TotalVentasInafectas"
                                                    ItemStyle-HorizontalAlign="Left" ItemStyle-Width="400px">
                                                    <ItemStyle HorizontalAlign="Left" Width="400px"></ItemStyle>
                                                </asp:BoundField>
                                                <asp:BoundField HeaderText="Sumatoria IGV" DataField="SumatoriaIGV"
                                                    ItemStyle-HorizontalAlign="Left" ItemStyle-Width="400px">
