                                                                <td>
                                                                    <asp:Button ID="btnProcesar" runat="server" Text="Procesar"
                                                                        OnClick="btnProcesar_Click" />
                                                                </td>
                                                                <td>
                                                                    <asp:Button ID="btnActualizar" runat="server" Text="Actualizar" Visible="false"
                                                                        OnClick="btnActualizar_Click" />
                                                                </td>
                                                                <td>
                                                                    <asp:Button ID="btnGetCDR" runat="server" Text="ObtenerCDR" Visible="true"
                                                                        OnClick="btnGetCDR_Click" />
                                                                </td>
                                                                <td>
                                                                    <asp:Button ID="btnGenerarPDF" runat="server" Text="GenerarPDF" Visible="true"
                                                                        OnClick="btnGenerarPDF_Click" />
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5">
